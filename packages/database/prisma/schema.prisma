generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql" url = env("DATABASE_URL") }
enum Role { ADMIN AGENT }
enum UserStatus { ACTIVE DISABLED }
enum ConversationStatus { OPEN WAITING CLOSED }
enum SenderType { CUSTOMER AGENT SYSTEM }
enum VisitorEventType { PAGE_VIEW PRODUCT_VIEW CHAT_OPEN CHAT_STARTED MESSAGE_SENT CHAT_CLOSED }
model Site { id String @id @default(cuid()) siteId String @unique name String domain String? whatsappNumber String? createdAt DateTime @default(now()) visitors Visitor[] quickReplies QuickReply[] }
model AdminUser { id String @id @default(cuid()) name String email String @unique passwordHash String role Role @default(AGENT) status UserStatus @default(ACTIVE) lastSeenAt DateTime? createdAt DateTime @default(now()) conversations Conversation[] messages Message[] quickReplies QuickReply[] }
model Visitor { id String @id @default(cuid()) siteId String visitorId String sessionId String firstSeenAt DateTime @default(now()) lastSeenAt DateTime @default(now()) currentUrl String? currentTitle String? referrer String? userAgent String? deviceType String? browser String? operatingSystem String? pageType String? productId String? productName String? productUrl String? category String? online Boolean @default(false) site Site @relation(fields:[siteId], references:[siteId]) conversations Conversation[] events VisitorEvent[] @@unique([siteId, visitorId]) @@index([visitorId]) @@index([lastSeenAt]) @@index([online]) }
model Conversation { id String @id @default(cuid()) visitorId String status ConversationStatus @default(WAITING) assignedAgentId String? startedAt DateTime @default(now()) updatedAt DateTime @updatedAt closedAt DateTime? visitor Visitor @relation(fields:[visitorId], references:[id], onDelete:Cascade) assignedAgent AdminUser? @relation(fields:[assignedAgentId], references:[id]) messages Message[] @@index([visitorId]) @@index([status]) @@index([updatedAt]) }
model Message { id String @id @default(cuid()) conversationId String senderType SenderType senderId String message String createdAt DateTime @default(now()) deliveredAt DateTime? readAt DateTime? metadata Json? clientMessageId String? agentId String? conversation Conversation @relation(fields:[conversationId], references:[id], onDelete:Cascade) agent AdminUser? @relation(fields:[agentId], references:[id]) @@unique([conversationId, clientMessageId]) @@index([conversationId]) @@index([createdAt]) }
model QuickReply { id String @id @default(cuid()) siteId String title String message String isActive Boolean @default(true) createdById String? createdAt DateTime @default(now()) updatedAt DateTime @updatedAt site Site @relation(fields:[siteId], references:[siteId]) createdBy AdminUser? @relation(fields:[createdById], references:[id]) @@index([siteId]) }
model VisitorEvent { id String @id @default(cuid()) visitorId String type VisitorEventType url String? title String? metadata Json? createdAt DateTime @default(now()) visitor Visitor @relation(fields:[visitorId], references:[id], onDelete:Cascade) @@index([visitorId]) @@index([type]) @@index([createdAt]) }
