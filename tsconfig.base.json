{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "baseUrl": ".",
    "paths": {
      "@temmuz/shared": ["packages/shared/src/index.ts"],
      "@temmuz/config": ["packages/config/src/index.ts"],
      "@temmuz/database": ["packages/database/src/index.ts"]
    }
  }
}
